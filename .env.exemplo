# Modelo do arquivo de ambiente do servidor.
#
# Em producao ele NAO fica dentro do projeto: vai para /etc/gestao-juridica.env,
# com dono root e permissao 600, e o systemd o carrega (EnvironmentFile). Assim
# os segredos nao entram no git nem ficam visiveis na listagem de processos.
#
#   sudo cp .env.exemplo /etc/gestao-juridica.env
#   sudo chmod 600 /etc/gestao-juridica.env
#   sudo nano /etc/gestao-juridica.env
#
# Em desenvolvimento nada disso e necessario: basta rodar "npm start".

# Ativa cookie seguro (so trafega em HTTPS) e confianca no proxy reverso.
NODE_ENV=production

# Porta local. O Caddy escuta em 80/443 e repassa para ca.
PORTA=3000

# Fuso horario. O sistema recusa subir com qualquer outro valor, porque todos
# os prazos processuais sao calculados no horario de Brasilia.
TZ=America/Sao_Paulo

# Assina os cookies de sessao. Obrigatoria em producao.
# Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar este valor desloga todo mundo.
SESSION_SECRET=cole-aqui-o-valor-gerado

# ---------------------------------------------------------------------
# DataJud / CNJ (andamento processual)
#
# Chave da API pública. Preferir aqui (sem commit) para poder trocar sem
# alterar código. Alternativa: gravar em Configurações no banco (datajud_chave)
# se esta variável NÃO estiver definida.
# ---------------------------------------------------------------------
# DATAJUD_API_KEY=
# DATAJUD_MAX_REQ_POR_MINUTO=60
# DATAJUD_LOTE=20
# DATAJUD_INTERVALO_MS=86400000
# DATAJUD_ATRASO_INICIAL_MS=3600000


# ---------------------------------------------------------------------
# Login com Google (opcional)
#
# As tres variaveis abaixo precisam estar preenchidas para o botao "Entrar com
# Google" aparecer na tela de login. Sem elas, o sistema funciona normalmente
# so com usuario e senha.
#
# Onde obter: console.cloud.google.com > APIs e servicos > Credenciais >
# Criar credenciais > ID do cliente OAuth > Aplicativo da Web.
# O REDIRECT_URI precisa ser cadastrado la, identico, em "URIs de
# redirecionamento autorizados".
# ---------------------------------------------------------------------
# GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
# GOOGLE_REDIRECT_URI=https://SEUNOME.duckdns.org/api/auth/google/callback

# ---------------------------------------------------------------------
# Backup (usado por implantacao/backup.sh)
# ---------------------------------------------------------------------
# Destino no rclone, no formato <remoto>:<pasta>
RCLONE_DESTINO=gdrive:BackupGestaoJuridica
# Acervo de documentos (vivo no Drive; nao e o backup diario)
RCLONE_ACERVO=gdrive:AcervoDocumentos
# Dias de retencao no destino
BACKUP_RETENCAO_DIAS=30
