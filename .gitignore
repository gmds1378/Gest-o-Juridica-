# Dependencias
node_modules/

# Banco de dados local (dados reais de clientes/processos do escritorio)
dados/

# Arquivos enviados (Modelos e Documentos) - podem conter documentos de clientes
uploads/**
!uploads/**/
!uploads/**/.gitkeep

# Variaveis de ambiente com segredos (o modelo versionado e o .env.exemplo)
.env
.env.local
*.env
!.env.exemplo

# Backups gerados localmente antes do envio ao Drive
backups/

# Logs e afins
npm-debug.log*
*.log

# Sistema
.DS_Store
Thumbs.db

# Configuracao local do Claude Code (ferramenta de dev, nao faz parte do app)
.claude/
